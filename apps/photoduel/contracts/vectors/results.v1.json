{
  "ruleVersion": "1",
  "description": "Golden vectors for the PhotoDuel tally. Kotlin ResultCalculator and the Node tally must both produce `expected` for every case. See docs/architecture.md section 8.",
  "conventions": {
    "roster": "Frozen roster at challenge start. Users are strings.",
    "activeMembers": "Roster members who are still room members at voting close. Leaving is blocked during active challenges, so this equals the roster in normal play.",
    "submissions": "Each submission has an author, and a status ACTIVE | WITHDRAWN | REMOVED | HIDDEN as of voting close.",
    "blocks": "Unordered pairs. A ballot is void when voter and target author are blocked in either direction.",
    "ballots": "Ballots in the order they were recorded. Only the first ballot per voter counts, because ballots are immutable.",
    "rules": [
      "P = ACTIVE submissions whose author is on the roster.",
      "A ballot counts when: voter is in activeMembers, target is in P, voter is not the author of target, and the pair is not blocked.",
      "If |P| < 2: INSUFFICIENT_SUBMISSIONS, ballotCount 0, tallies [].",
      "Else if counted ballots < 2: INSUFFICIENT_BALLOTS, tallies for every P entry.",
      "Else the maximum vote count decides: one leader is WINNER, several are TIE with all leaders as coWinnerSubmissionIds.",
      "tallies and coWinnerSubmissionIds are sorted by submission id, ascending by string comparison."
    ],
    "coWinnerRule": "For WINNER, coWinnerSubmissionIds contains exactly the winner. For TIE it contains every leader. Otherwise it is empty."
  },
  "cases": [
    {
      "name": "winner_simple",
      "roster": [
        "a",
        "b",
        "c"
      ],
      "activeMembers": [
        "a",
        "b",
        "c"
      ],
      "submissions": [
        {
          "id": "sa",
          "author": "a",
          "status": "ACTIVE"
        },
        {
          "id": "sb",
          "author": "b",
          "status": "ACTIVE"
        },
        {
          "id": "sc",
          "author": "c",
          "status": "ACTIVE"
        }
      ],
      "blocks": [],
      "ballots": [
        {
          "voter": "a",
          "submission": "sb"
        },
        {
          "voter": "b",
          "submission": "sc"
        },
        {
          "voter": "c",
          "submission": "sb"
        }
      ],
      "expected": {
        "outcome": "WINNER",
        "coWinnerSubmissionIds": [
          "sb"
        ],
        "tallies": [
          {
            "submissionId": "sa",
            "votes": 0
          },
          {
            "submissionId": "sb",
            "votes": 2
          },
          {
            "submissionId": "sc",
            "votes": 1
          }
        ],
        "winnerSubmissionId": "sb",
        "ballotCount": 3,
        "eligibleVoterCount": 3
      }
    },
    {
