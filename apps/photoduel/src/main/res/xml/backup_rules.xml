<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android 12 equivalent of data_extraction_rules.xml (android:fullBackupContent). With
  android:allowBackup="false" no backup happens at all; this file keeps the session file excluded even
  if that attribute is ever changed by mistake.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/photoduel_session.preferences_pb" />
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
