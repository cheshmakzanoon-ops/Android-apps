<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup and transfer rules. The app keeps no data worth restoring (the server is the source
  of truth), and the encrypted session token must never leave the device: its Keystore key is not
  backed up, so a restored copy would be unreadable anyway. Everything is excluded from both cloud
  backup and device-to-device transfer. The session file is also named explicitly so that the intent
  survives a future edit of the blanket rules. android:allowBackup is "false" as well.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/photoduel_session.preferences_pb" />
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/photoduel_session.preferences_pb" />
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
