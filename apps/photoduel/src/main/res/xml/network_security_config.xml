<?xml version="1.0" encoding="utf-8"?>
<!--
  Release and default policy: HTTPS only, system trust anchors only, no exceptions.
  The debug build replaces this file (src/debug/res/xml/network_security_config.xml) to allow cleartext
  to the emulator's host alias and localhost, and nothing else.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
