# PhotoDuel backend configuration. Copy to .env (git-ignored) and edit, then load it with
#   node --env-file=.env dist/src/server.js      or      set -a; . ./.env; set +a
# Every value here is a placeholder or a documented default. Never commit real secrets.

# Runtime. NODE_ENV is development, test or production.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
# true only behind a reverse proxy you control (client IPs then come from X-Forwarded-For)
TRUST_PROXY=false

# PostgreSQL 16. Replace USER, PORT and DATABASE.
DATABASE_URL=postgres://USER@127.0.0.1:PORT/DATABASE
# Lowercase SQL identifier; npm run migrate creates it when it is not public.
DATABASE_SCHEMA=public
PG_POOL_MAX=10

# Private photo storage, relative to the backend folder. Never served directly.
MEDIA_ROOT=var/media
# Curated prompt catalogue owned by the engine lane, read in place.
PROMPTS_PATH=../assets/source/prompts/prompts.v1.json

# Secrets. Required in production (16 or more characters each). Generate your own random values.
IP_HASH_SALT=replace-with-a-long-random-value
RECOVERY_CODE_PEPPER=replace-with-a-long-random-value
RECOVERY_SCRYPT_N=16384

# Background worker. Set WORKER_IN_PROCESS=false when it runs as its own process (npm run worker).
WORKER_IN_PROCESS=true
WORKER_INTERVAL_MS=30000

# Limits. Defaults from architecture.md section 10.
SESSION_TTL_DAYS=90
GUESTS_PER_IP_PER_HOUR=10
RESTORE_FAILURES_PER_IP_PER_HOUR=5
ROOMS_PER_USER_PER_DAY=5
ACTIVE_INVITATIONS_PER_ROOM=5
ROOM_CAPACITY=8
MIN_MEMBERS_TO_START=3
UPLOADS_PER_USER_PER_DAY=30
UPLOAD_BYTES_PER_USER_PER_DAY=62914560
UPLOAD_BODY_LIMIT_BYTES=3145728
JSON_BODY_LIMIT_BYTES=16384
BALLOTS_PER_USER_PER_MINUTE=60
REPORTS_PER_USER_PER_DAY=20
AUTO_HIDE_REPORTERS=3
MAX_INPUT_PIXELS=40000000
MIN_SHORT_EDGE_PX=200

# Moderation CLI operator name, written to audit_log. --operator overrides it.
MOD_OPERATOR=operator-name

# Tests only. Point it at a disposable database: each test file creates and drops its own schema.
TEST_DATABASE_URL=postgres://USER@127.0.0.1:PORT/TEST_DATABASE
