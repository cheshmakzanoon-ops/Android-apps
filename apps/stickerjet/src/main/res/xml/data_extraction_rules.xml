<?xml version="1.0" encoding="utf-8"?>
<!-- Device-to-device transfer and cloud backup both exclude app data. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
